generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Birthday {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  month     Int
  day       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId], name: "guildId_userId")
  @@index([guildId, month, day])
}
